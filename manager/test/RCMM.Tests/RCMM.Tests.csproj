<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RCMM.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RCMM.Core\RCMM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked from the app project so RcmmActionScriptTests exercises the
         exact script the installer ships, not a copy that can drift. -->
    <None Include="..\..\src\RCMM\rcmm-action.ps1" Link="rcmm-action.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
